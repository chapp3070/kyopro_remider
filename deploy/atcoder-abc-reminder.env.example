# Copy this file to /etc/atcoder-abc-reminder/atcoder-abc-reminder.env.
# Do not commit the copied file or place a real webhook URL under /srv/shared/remider.
ATCODER_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace-with-webhook-id/replace-with-webhook-token
ATCODER_DISCORD_ROLE_ID=replace-with-competitive-programming-role-id
# Optional; the default is /srv/shared/remider/state.db.
# ATCODER_STATE_DB=/srv/shared/remider/state.db
