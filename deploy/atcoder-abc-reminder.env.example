# Copy this file to /etc/atcoder-abc-reminder/atcoder-abc-reminder.env.
# Do not commit the copied file or place a real token under /srv/shared/remider.
ATCODER_DISCORD_BOT_TOKEN=replace-with-discord-bot-token
ATCODER_DISCORD_CHANNEL_ID=replace-with-numeric-channel-id
# Optional; the default is /srv/shared/remider/state.db.
# ATCODER_STATE_DB=/srv/shared/remider/state.db
